{
  // Explorer
  //"explorer.file.root.template": "[icon] [git] [hidden & 1][root]",
  "explorer.width": 30,
  "explorer.buffer.root.template": "[icon & 1] OPEN EDITORS",
  "explorer.file.root.template": "[icon] [git] [hidden & 1] PROJECT ([root])",
  "explorer.file.child.template": "[git | 2] [selection | clip | 1] [indent][icon | 1] [diagnosticError & 1][filename omitCenter 1][modified][readonly] [linkIcon & 1][link growRight 1 omitCenter 5]",
  "explorer.icon.enableNerdfont": true,
  "explorer.icon.source": "vim-devicons",
  "explorer.previewAction.onHover": false,
  "explorer.file.showHiddenFiles": false,
  "explorer.keyMappings.global": {
    "<cr>": [
      "expandable?",
      "expand",
      "open"
    ],
    "h": "open:split",
    "v": "open:vsplit",
    "mm": "rename",
    "mc": "copyFile",
    "C": "copyFile",
    "md": "delete",
    "D": "delete",
    "ma": "addFile",
    "mA": "addDirectory"
  },
  // Auto format
  "coc.preferences.formatOnSave": true,
  // snippets
  "snippets.userSnippetsDirectory": "C:\\Users\\AlanJui\\vimfiles\\snips",
  "snippets.loadFromExtensions": true,
  "snippets.ultisnips.enable": true,
  "snippets.snipmate.enable": false,
  // VS Code snippets
  //  - Ubuntu:  "C:\Users\AlanJui\vimfilesg\Code/User/snippets"
  //  - macOS:   "~/Library/Application Support/Code/User/snippets"
  "snippets.textmateSnippetsRoots": [
    "C:\\Users\\AlanJui\\vimfiles\\snips"
  ],
  // emmet
  "emmet.showExpandedAbbreviation": "always",
  "emmet.showAbbreviationSuggestions": true,
  "emmet.includeLanguages": {
    "htmldjango": "html",
    "django-html": "html",
    "python.django": "python",
    "vue-html": "html",
    "javascript": "javascriptreact"
  },
  "suggest.maxCompleteItemCount": 20,
  "suggest.noselect": false,
  // diagnostics
  "diagnostic.errorSign": " ",
  "diagnostic.warningSign": " ",
  "diagnostic.infoSign": "",
  "diagnostic.hintSign": " ",
  //=================================================================================================
  // coc-pyright: https://github.com/neoclide/coc-python
  // "python.analysis.autoImportCompletions": true,
  // "python.analysis.autoSearchPaths": true,
  // "python.analysis.diagnosticMode": "workspace",
  // 設定 Python 解譯器的路徑
  "python.pythonPath": "C:\\Users\\AlanJui\\AppData\\Local\\Programs\\Python\\Python313\\python.exe",
  // "python.venvPath": "C:/Users/alanjui/.pyenv/versions/3.9.1/envs",
  "python.venvFolders": [
    ".venv",
    "venv"
  ],
  //"python.formatting.provider": "autopep8",
  // "python.formatting.autopep8Args": [
  //   "--ignore=E402"
  // ],
  "python.formatting.provider": "black",
  "python.formatting.blackPath": "black",
  "python.formatting.blackArgs": [
    "--line-length",
    "88"
  ],
  // (選擇性) 自動儲存時格式化 Python
  "coc.preferences.formatOnSaveFiletypes": [
    "python"
  ],
  // 啟用 pyright
  "pyright.enable": true,
  "pyright.disableCompletion": false,
  // (選擇性) 是否顯示診斷訊息
  "pyright.disableDiagnostics": false,
  // (選擇性) Type checking level
  // "pyright.typeCheckingMode": "basic",
  // "pyright.typeCheckingMode": "off",
  "pyright.typeCheckingMode": "none",
  // 視需求可關閉其他常見警告
  // 注意：以下設定通常在 "python.analysis" 或 "pyright" namespace 之下
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "none",
    "reportUnusedVariable": "none",
    "reportOptionalSubscript": "none",
    "reportOptionalMemberAccess": "none",
    "reportOptionalCall": "none"
    // 視需求，可以再加其他想關閉的 rule
  },
  // 是否禁用 Pyright 診斷 (通常不建議全部關閉)
  "pyright.disableDiagnostics": true,
  // 若先前開啟了任何 linting，可以考慮關閉
  // "python.linting.enabled": false,
  // "python.linting.enabled": true,
  // "python.linting.pylintEnabled": true,
  // "python.linting.pylintArgs": [
  //   "--disable=F401, E722, C0116, C0115, W0613"
  // ],
  // "python.linting.mypyArgs": [
  //   "--ignore-missing-imports",
  //   "--follow-imports=silent",
  //   "--show-column-numbers"
  // ],
  // "python.linting.ignorePatterns": [
  //   ".vscode/*.py",
  //   "**/site-packages/**/*.py"
  // ],
  "snippets.ultisnips.pythonPrompt": false
}